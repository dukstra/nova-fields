{
    "name": "dukstra/nova-fields",
    "description": "Nova 5 Vue 3 fields used by RSA Pharma.",
    "keywords": [
        "laravel",
        "nova",
        "nova-5",
        "vue-3"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Dukstra\\NovaFields\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dukstra\\NovaFields\\FieldServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "homepage": "https://github.com/dukstra/nova-fields",
    "authors": [
        {
            "name": "Dukstra"
        }
    ],
    "require-dev": {
        "laravel/nova": "^5.0",
        "laravel/nova-devtool": "^1.11"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://nova.laravel.com"
        }
    ]
}
